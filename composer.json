{
  "name": "wexample/php-git",
  "description": "Reading a git repository's history and committing given paths, framework-agnostic",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Wexample",
      "email": "contact@wexample.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.5",
    "symfony/process": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\PhpGit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\PhpGit\\Tests\\": "tests/"
    }
  }
}
